# OpenShift 4.22 hosted cluster -- the original lab cluster.
#
#   CLUSTER_PROFILE=sim0 ./01-create-hostedcluster.sh
#
# RELEASE_IMAGE is left unset so it resolves to the management cluster's own
# release image (a CI nightly, pullable because the cluster pull-secret carries
# registry.ci.openshift.org credentials).
#
#   OCP 4.22.22 -> kubernetes 1.35

export HC_NAME=sim0
export KUBEMARK_VERSION=v1.35.7
