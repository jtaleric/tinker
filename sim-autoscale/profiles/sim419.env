# OpenShift 4.19.22 hosted cluster.
#
#   CLUSTER_PROFILE=sim419 ./01-create-hostedcluster.sh
#   CLUSTER_PROFILE=sim419 ./04-wire-capi.sh
#
# KUBEMARK_VERSION must track the hosted cluster's Kubernetes minor, because it
# selects both the Machine's spec.version and the kubemark image tag. A mismatch
# means hollow kubelets of the wrong vintage registering against the API server.
#
#   OCP 4.19.22 -> kubernetes 1.32.10   (verified via oc adm release info)
#
# Only v1.32.8 is published for the 1.32 line, so the patch level differs from
# the control plane's 1.32.10. That is fine -- kubelet/API-server skew is
# supported within a minor -- but do not let the MINOR drift.

export HC_NAME=sim419
export RELEASE_IMAGE=quay.io/openshift-release-dev/ocp-release:4.19.22-x86_64
export KUBEMARK_VERSION=v1.32.8
