# Stage 1: Build the Go Binary
FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY main.go .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o couchbase-api main.go

# Stage 2: Minimal Runtime Image
FROM alpine:3.19
RUN apk --no-cache add ca-certificates

WORKDIR /app
COPY --from=builder /app/couchbase-api .

USER 10001
EXPOSE 8080

ENTRYPOINT ["./couchbase-api"]
